# Copy this file to ".env" (same folder) and adjust.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://scholars:scholars@localhost:5432/scholars_dev
CORS_ORIGIN=http://localhost:5173

# Google sign-in. Leave empty until you have created the Google client ID (we do this together in step 3).
GOOGLE_CLIENT_ID=
# Number of proxies in front of the API in production (0 when running on your laptop).
TRUST_PROXY=0

# Tests use a SEPARATE database. Its name MUST end in "_test" (safety guard — tests wipe it).
TEST_DATABASE_URL=postgres://scholars:scholars@localhost:5432/scholars_test
