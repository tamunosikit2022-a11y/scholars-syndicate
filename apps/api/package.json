{
  "name": "@scholars/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:reset": "tsx src/db/reset-cli.ts",
    "questions:validate": "tsx scripts/validate-question-bank.ts",
    "roles:grant": "tsx src/auth/roles-cli.ts"
  },
  "dependencies": {
    "@scholars/shared": "*",
    "cookie": "1.1.1",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
